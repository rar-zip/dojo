#!/usr/bin/env python3
"""dojo —— 装在自己机器上的 Linux 陪练

默认只说话不动手。到了 L5 才允许代跑，而且一步一确认，随时能刹车，默认回滚。

命令：
  dojo                     当前状态
  dojo status              查看详细运行状态
  dojo chat                连着聊，问不清楚可以追问
  dojo ask "问题"           问一句就走
  dojo explain             解释上一条命令
  dojo do "想做的事"        让它给方案；L5 下逐步确认执行
  dojo run "命令"           直接跑一条（仍然要确认）
  dojo preview "命令"       在 overlayfs 沙盒里先跑，看完再决定应用或丢弃
  dojo undo [ID] [N|all]   回滚最近一次或指定运行
  dojo history [N]         看运行记录
  dojo stop [--abort]      给正在跑的任务发停止或中断请求
  dojo level [1-5]         看/切协助等级
  dojo config [get|set]    查看或修改配置项
  dojo log                 看它到底看到了什么
  dojo doctor              自检
  dojo upgrade             拉最新版装上
  dojo init                装 shell hook
  dojo uninstall           干净卸载 dojo 及配置/状态
"""

import hashlib
import itertools
